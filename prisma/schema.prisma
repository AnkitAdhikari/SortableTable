generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model User {
  id Int @id @default(autoincrement())
  name String @db.Text
  age Int
  address String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}